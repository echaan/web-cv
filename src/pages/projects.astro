---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/sections/Nav.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import ProjectList from '../components/ui/ProjectList.astro';
import Icon from '../components/ui/Icon.astro';
import { projects } from '../lib/data';

const initialProject = projects[0];
const initialPdf = initialProject?.slidesPdf ?? '';
const initialTitle = initialProject?.title ?? '';
const initialFilename = initialPdf ? initialPdf.split('/').pop() : '';
---

<BaseLayout title="Projects">
  <Nav />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 lg:pt-24 pb-16 sm:pb-20">
    <main
      id="main-content"
      class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-7 lg:p-8"
      aria-labelledby="all-projects-heading"
    >
      <div class="mb-4">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors mb-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-xs"
        >
          <Icon name="arrow-left" class="w-4 h-4 shrink-0" aria-hidden="true" />
          <span>Back to CV</span>
        </a>
        <SectionTitle title="All Projects" id="all-projects-heading" icon="folder" class="mb-3" />
      </div>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6 -mt-1">
        A complete collection of data analysis, machine learning, and software development projects.
      </p>

      <!-- Two-column master-detail layout (Desktop: lg:grid 2 columns; Mobile/Tablet: stacked list first, viewer below) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left column: Project list -->
        <div class="lg:col-span-5 flex flex-col">
          <ProjectList projects={projects} showViewSlides={true} />
        </div>

        <!-- Right column: Minimal Document Viewer (sticky on desktop) -->
        <div class="lg:col-span-7 lg:sticky lg:top-24">
          <section
            id="slides-viewer-panel"
            aria-labelledby="viewer-title"
            class="bg-slate-50/70 rounded-xl border border-slate-200/90 overflow-hidden flex flex-col"
          >
            <!-- Slim Header -->
            <header class="flex items-center justify-between gap-3 px-4 py-3 bg-white border-b border-slate-200/90 min-h-[52px]">
              <div class="flex items-center gap-2.5 min-w-0 flex-1">
                <Icon name="file-text" class="w-4 h-4 text-slate-500 shrink-0" aria-hidden="true" />
                <div class="min-w-0 flex items-baseline gap-2">
                  <h2
                    id="viewer-title"
                    class="text-sm font-semibold text-slate-900 truncate"
                  >
                    {initialTitle ? `${initialTitle} Slides` : 'Project Slides'}
                  </h2>
                  <span
                    id="viewer-filename"
                    class="text-xs text-slate-500 truncate hidden sm:inline"
                  >
                    {initialFilename ? `(${initialFilename})` : ''}
                  </span>
                </div>
              </div>

              <!-- Action Buttons -->
              <div id="viewer-actions" class={`items-center gap-1.5 shrink-0 ${initialPdf ? 'flex' : 'hidden'}`}>
                <a
                  id="viewer-download-btn"
                  href={initialPdf || '#'}
                  download
                  class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded-lg hover:text-blue-600 hover:border-slate-300 hover:bg-slate-50 active:bg-slate-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[34px]"
                  aria-label="Download presentation slides"
                  title="Download slides"
                >
                  <Icon name="download" class="w-3.5 h-3.5" aria-hidden="true" />
                  <span>Download</span>
                </a>
                <a
                  id="viewer-open-btn"
                  href={initialPdf || '#'}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded-lg hover:text-blue-600 hover:border-slate-300 hover:bg-slate-50 active:bg-slate-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[34px]"
                  aria-label="Open presentation slides in new tab"
                  title="Open in new tab"
                >
                  <Icon name="external-link" class="w-3.5 h-3.5" aria-hidden="true" />
                  <span>Open</span>
                </a>
              </div>
            </header>

            <!-- Viewer Body Container (~70vh on desktop) -->
            <div class="p-3 sm:p-4 bg-slate-100/50 flex-1 flex flex-col min-h-0">
              <!-- Active PDF Slide Deck Container -->
              <div
                id="viewer-frame-container"
                class={`w-full rounded-lg overflow-hidden border border-slate-200/90 bg-white shadow-2xs flex flex-col ${initialPdf ? 'flex' : 'hidden'}`}
              >
                <!-- Canvas & Annotation viewport area with swipe & link overlay -->
                <div
                  id="slide-canvas-viewport"
                  class="relative w-full overflow-hidden bg-slate-900/5 flex items-center justify-center select-none touch-pan-y min-h-[300px] sm:min-h-[380px] lg:min-h-[460px] cursor-grab active:cursor-grabbing"
                  tabindex="0"
                  role="region"
                  aria-label="Slide presentation canvas, use left and right arrow keys to navigate"
                >
                  <!-- Loading overlay -->
                  <div
                    id="slide-loading-indicator"
                    class="absolute inset-0 z-20 bg-white/80 backdrop-blur-xs flex items-center justify-center transition-opacity duration-150 hidden"
                    aria-hidden="true"
                  >
                    <div class="flex items-center gap-2 text-xs font-medium text-slate-600 bg-white px-3 py-1.5 rounded-full border border-slate-200 shadow-xs">
                      <div class="w-3.5 h-3.5 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
                      <span>Loading slide...</span>
                    </div>
                  </div>

                  <!-- Canvas Stage wrapper (holds canvas + clickable annotations) -->
                  <div id="slide-stage" class="relative inline-block max-w-full leading-none">
                    <canvas id="slide-canvas" class="block max-w-full h-auto mx-auto shadow-xs"></canvas>
                    <div id="slide-annotation-layer" class="absolute inset-0 pointer-events-none" aria-hidden="false"></div>
                  </div>
                </div>

                <!-- Slide Navigation Toolbar (Bottom) -->
                <footer class="flex items-center justify-between gap-3 px-4 py-2.5 bg-white border-t border-slate-200/90">
                  <button
                    id="prev-slide-btn"
                    type="button"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs sm:text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-lg hover:text-blue-600 hover:border-slate-300 hover:bg-slate-50 active:bg-slate-100 disabled:opacity-40 disabled:pointer-events-none transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[36px]"
                    aria-label="Previous slide"
                    title="Previous slide (Left arrow)"
                  >
                    <Icon name="chevron-left" class="w-4 h-4 shrink-0" aria-hidden="true" />
                    <span class="hidden sm:inline">Previous</span>
                  </button>

                  <!-- Page Indicator with aria-live -->
                  <div class="flex items-center gap-2">
                    <span
                      id="slide-counter"
                      class="text-xs sm:text-sm font-medium text-slate-600 tabular-nums select-none"
                      aria-live="polite"
                      aria-atomic="true"
                    >
                      1 / 1
                    </span>
                  </div>

                  <button
                    id="next-slide-btn"
                    type="button"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs sm:text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-lg hover:text-blue-600 hover:border-slate-300 hover:bg-slate-50 active:bg-slate-100 disabled:opacity-40 disabled:pointer-events-none transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[36px]"
                    aria-label="Next slide"
                    title="Next slide (Right arrow)"
                  >
                    <span class="hidden sm:inline">Next</span>
                    <Icon name="chevron-right" class="w-4 h-4 shrink-0" aria-hidden="true" />
                  </button>
                </footer>
              </div>

              <!-- Neutral Empty State -->
              <div
                id="viewer-empty-state"
                class={`w-full rounded-lg border border-dashed border-slate-300 bg-white flex flex-col items-center justify-center text-center p-8 h-[320px] sm:h-[400px] lg:h-[70vh] ${initialPdf ? 'hidden' : 'flex'}`}
              >
                <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-3">
                  <Icon name="file-text" class="w-6 h-6" aria-hidden="true" />
                </div>
                <h3 id="empty-state-title" class="text-sm font-semibold text-slate-900 mb-1">No Slides Available</h3>
                <p id="empty-state-message" class="text-xs sm:text-sm text-slate-500 max-w-xs mb-3">
                  Presentation slides have not been provided for this project.
                </p>
                <a
                  id="empty-state-download-btn"
                  href="#"
                  download
                  class="hidden items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
                >
                  <Icon name="download" class="w-3.5 h-3.5" aria-hidden="true" />
                  <span>Download file directly</span>
                </a>
              </div>
            </div>
          </section>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  pdfjsLib.GlobalWorkerOptions.workerSrc = workerUrl;

  function setupProjectViewer() {
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const viewerTitle = document.getElementById('viewer-title');
    const viewerFilename = document.getElementById('viewer-filename');
    const viewerDownloadBtn = document.getElementById('viewer-download-btn') as HTMLAnchorElement | null;
    const viewerOpenBtn = document.getElementById('viewer-open-btn') as HTMLAnchorElement | null;
    const viewerActions = document.getElementById('viewer-actions');
    const frameContainer = document.getElementById('viewer-frame-container');
    const emptyState = document.getElementById('viewer-empty-state');
    const emptyStateTitle = document.getElementById('empty-state-title');
    const emptyStateMessage = document.getElementById('empty-state-message');
    const emptyStateDownloadBtn = document.getElementById('empty-state-download-btn') as HTMLAnchorElement | null;

    const viewportContainer = document.getElementById('slide-canvas-viewport');
    const canvas = document.getElementById('slide-canvas') as HTMLCanvasElement | null;
    const annotationLayer = document.getElementById('slide-annotation-layer');
    const loadingIndicator = document.getElementById('slide-loading-indicator');
    const prevBtn = document.getElementById('prev-slide-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next-slide-btn') as HTMLButtonElement | null;
    const slideCounter = document.getElementById('slide-counter');

    if (!cards.length) return;

    let currentPdfDoc: any = null;
    let currentPageNum = 1;
    let totalPages = 0;
    let currentRenderTask: any = null;
    let renderSeq = 0;

    function showLoading(show: boolean) {
      if (loadingIndicator) {
        if (show) {
          loadingIndicator.classList.remove('hidden');
        } else {
          loadingIndicator.classList.add('hidden');
        }
      }
    }

    function showEmptyState(title: string, message: string, downloadUrl?: string) {
      if (frameContainer) {
        frameContainer.classList.add('hidden');
        frameContainer.classList.remove('flex');
      }
      if (emptyState) {
        emptyState.classList.remove('hidden');
        emptyState.classList.add('flex');
      }
      if (emptyStateTitle) {
        emptyStateTitle.textContent = title;
      }
      if (emptyStateMessage) {
        emptyStateMessage.textContent = message;
      }
      if (emptyStateDownloadBtn) {
        if (downloadUrl) {
          emptyStateDownloadBtn.href = downloadUrl;
          emptyStateDownloadBtn.classList.remove('hidden');
          emptyStateDownloadBtn.classList.add('inline-flex');
        } else {
          emptyStateDownloadBtn.classList.add('hidden');
          emptyStateDownloadBtn.classList.remove('inline-flex');
        }
      }
      if (slideCounter) {
        slideCounter.textContent = '0 / 0';
      }
    }

    function updateNavControls() {
      if (prevBtn) {
        prevBtn.disabled = currentPageNum <= 1;
      }
      if (nextBtn) {
        nextBtn.disabled = currentPageNum >= totalPages;
      }
      if (slideCounter) {
        slideCounter.textContent = totalPages > 0 ? `${currentPageNum} / ${totalPages}` : '0 / 0';
      }
    }

    async function renderPage(pageNum: number) {
      if (!currentPdfDoc || !canvas || !viewportContainer) return;

      if (currentRenderTask) {
        try {
          currentRenderTask.cancel();
        } catch {
          // ignore cancellation
        }
        currentRenderTask = null;
      }

      const thisSeq = ++renderSeq;
      showLoading(true);

      try {
        const page = await currentPdfDoc.getPage(pageNum);
        if (thisSeq !== renderSeq) return;

        // Determine available container width (default to 600 if 0 or hidden)
        const containerWidth = viewportContainer.clientWidth || 600;
        const unscaledViewport = page.getViewport({ scale: 1 });
        const targetWidth = Math.max(containerWidth - 32, 280);
        const scale = targetWidth / unscaledViewport.width;
        const viewport = page.getViewport({ scale });

        const dpr = window.devicePixelRatio || 1;
        canvas.width = Math.floor(viewport.width * dpr);
        canvas.height = Math.floor(viewport.height * dpr);
        canvas.style.width = `${Math.floor(viewport.width)}px`;
        canvas.style.height = `${Math.floor(viewport.height)}px`;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        ctx.save();
        ctx.scale(dpr, dpr);

        const renderContext = {
          canvasContext: ctx,
          viewport: viewport,
        };

        currentRenderTask = page.render(renderContext);
        await currentRenderTask.promise;
        ctx.restore();
        if (thisSeq !== renderSeq) return;

        // Render clickable annotations overlay
        if (annotationLayer) {
          annotationLayer.innerHTML = '';
          annotationLayer.style.width = `${Math.floor(viewport.width)}px`;
          annotationLayer.style.height = `${Math.floor(viewport.height)}px`;

          const annotations = await page.getAnnotations();
          if (thisSeq !== renderSeq) return;

          for (const annot of annotations) {
            if (annot.subtype === 'Link' && (annot.url || annot.unsafeUrl)) {
              const url = annot.url || annot.unsafeUrl;
              // Convert PDF rect [x1, y1, x2, y2] to viewport coordinates
              let left = 0;
              let top = 0;
              let width = 0;
              let height = 0;

              if (typeof viewport.convertToViewportRectangle === 'function') {
                const rect = viewport.convertToViewportRectangle(annot.rect);
                left = Math.min(rect[0], rect[2]);
                top = Math.min(rect[1], rect[3]);
                width = Math.abs(rect[2] - rect[0]);
                height = Math.abs(rect[3] - rect[1]);
              } else if (typeof viewport.convertToViewportPoint === 'function') {
                const p1 = viewport.convertToViewportPoint(annot.rect[0], annot.rect[1]);
                const p2 = viewport.convertToViewportPoint(annot.rect[2], annot.rect[3]);
                left = Math.min(p1[0], p2[0]);
                top = Math.min(p1[1], p2[1]);
                width = Math.abs(p2[0] - p1[0]);
                height = Math.abs(p2[1] - p1[1]);
              }

              const linkEl = document.createElement('a');
              linkEl.href = url;
              linkEl.target = '_blank';
              linkEl.rel = 'noopener noreferrer';
              linkEl.className = 'absolute pointer-events-auto rounded-xs hover:bg-blue-500/15 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:outline-none transition-colors';
              linkEl.style.left = `${left}px`;
              linkEl.style.top = `${top}px`;
              linkEl.style.width = `${width}px`;
              linkEl.style.height = `${height}px`;
              linkEl.title = annot.url || 'External link';
              linkEl.setAttribute('aria-label', `Open link: ${url}`);
              annotationLayer.appendChild(linkEl);
            }
          }
        }

        currentPageNum = pageNum;
        updateNavControls();
      } catch (err: any) {
        if (err?.name === 'RenderingCancelledException') {
          return;
        }
        console.error('Error rendering page:', err);
      } finally {
        if (thisSeq === renderSeq) {
          showLoading(false);
        }
      }
    }

    async function loadPdf(url: string) {
      if (currentRenderTask) {
        try {
          currentRenderTask.cancel();
        } catch {
          // ignore
        }
        currentRenderTask = null;
      }
      renderSeq++;

      if (currentPdfDoc) {
        try {
          currentPdfDoc.destroy();
        } catch {
          // ignore
        }
        currentPdfDoc = null;
      }

      currentPageNum = 1;
      totalPages = 0;

      if (!url) {
        showEmptyState(
          'No Slides Available',
          'Presentation slides have not been provided for this project.'
        );
        return;
      }

      showLoading(true);

      // Show container, hide empty state
      if (emptyState) {
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');
      }
      if (frameContainer) {
        frameContainer.classList.remove('hidden');
        frameContainer.classList.add('flex');
      }

      try {
        const loadingTask = pdfjsLib.getDocument({ url });
        currentPdfDoc = await loadingTask.promise;
        totalPages = currentPdfDoc.numPages;
        currentPageNum = 1;
        updateNavControls();
        await renderPage(1);
      } catch (err) {
        console.error('Failed to load PDF:', err);
        showEmptyState(
          'Unable to Load Slides',
          'The presentation could not be displayed in the viewer. You can download the file directly.',
          url
        );
      } finally {
        showLoading(false);
      }
    }

    function goToNextPage() {
      if (currentPageNum < totalPages) {
        renderPage(currentPageNum + 1);
      }
    }

    function goToPrevPage() {
      if (currentPageNum > 1) {
        renderPage(currentPageNum - 1);
      }
    }

    // Attach Prev / Next button listeners
    if (prevBtn) {
      prevBtn.addEventListener('click', goToPrevPage);
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', goToNextPage);
    }

    // Keyboard navigation: Left/Right arrow keys
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      // Don't trigger if focus is in an input or textarea
      const targetTag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (targetTag === 'input' || targetTag === 'textarea' || targetTag === 'select') {
        return;
      }

      if (e.key === 'ArrowRight') {
        if (currentPageNum < totalPages) {
          e.preventDefault();
          goToNextPage();
        }
      } else if (e.key === 'ArrowLeft') {
        if (currentPageNum > 1) {
          e.preventDefault();
          goToPrevPage();
        }
      }
    });

    // Touch Swipe navigation on viewportContainer
    if (viewportContainer) {
      let touchStartX = 0;
      let touchStartY = 0;

      viewportContainer.addEventListener(
        'touchstart',
        (e: TouchEvent) => {
          if (e.touches.length > 0) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
          }
        },
        { passive: true }
      );

      viewportContainer.addEventListener(
        'touchend',
        (e: TouchEvent) => {
          if (e.changedTouches.length > 0) {
            const touchEndX = e.changedTouches[0].clientX;
            const touchEndY = e.changedTouches[0].clientY;
            const diffX = touchEndX - touchStartX;
            const diffY = touchEndY - touchStartY;

            // Ensure horizontal swipe is dominant and exceeds threshold (40px)
            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
              if (diffX < 0) {
                // Swipe left -> Next slide
                goToNextPage();
              } else {
                // Swipe right -> Previous slide
                goToPrevPage();
              }
            }
          }
        },
        { passive: true }
      );
    }

    // Window resize handler: re-render current page with updated scale
    let resizeTimer: any = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (currentPdfDoc && currentPageNum > 0) {
          renderPage(currentPageNum);
        }
      }, 150);
    });

    function selectProject(card: HTMLElement) {
      // Update aria-current on all cards
      cards.forEach((c) => {
        c.setAttribute('aria-current', 'false');
      });
      card.setAttribute('aria-current', 'true');

      const title = card.getAttribute('data-project-title') || 'Project';
      const pdf = card.getAttribute('data-slides-pdf') || '';
      const filename = pdf ? pdf.split('/').pop() || '' : '';

      // Update Header Text
      if (viewerTitle) {
        viewerTitle.textContent = pdf ? `${title} Slides` : `${title}`;
      }
      if (viewerFilename) {
        viewerFilename.textContent = filename ? `(${filename})` : '';
      }

      if (pdf) {
        // Show Actions
        if (viewerActions) {
          viewerActions.classList.remove('hidden');
          viewerActions.classList.add('flex');
        }
        if (viewerDownloadBtn) {
          viewerDownloadBtn.href = pdf;
          viewerDownloadBtn.setAttribute('aria-label', `Download presentation slides for ${title}`);
        }
        if (viewerOpenBtn) {
          viewerOpenBtn.href = pdf;
          viewerOpenBtn.setAttribute('aria-label', `Open presentation slides for ${title} in new tab`);
        }

        loadPdf(pdf);
      } else {
        // Hide Actions
        if (viewerActions) {
          viewerActions.classList.add('hidden');
          viewerActions.classList.remove('flex');
        }

        loadPdf('');
      }
    }

    // Set first card selected initially and load its PDF
    const firstCard = cards[0];
    if (firstCard) {
      firstCard.setAttribute('aria-current', 'true');
      const initialPdf = firstCard.getAttribute('data-slides-pdf') || '';
      if (initialPdf) {
        loadPdf(initialPdf);
      } else {
        loadPdf('');
      }
    }

    // Attach click listeners to "View Slides" buttons
    const buttons = document.querySelectorAll<HTMLButtonElement>('.view-slides-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetSlug = btn.getAttribute('data-target-slug');
        if (!targetSlug) return;
        const matchingCard = document.querySelector<HTMLElement>(`.project-card[data-project-slug="${targetSlug}"]`);
        if (matchingCard) {
          selectProject(matchingCard);
          // On mobile, scroll viewer into view smoothly
          if (window.innerWidth < 1024) {
            const viewerPanel = document.getElementById('slides-viewer-panel');
            if (viewerPanel) {
              viewerPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectViewer);
  } else {
    setupProjectViewer();
  }
</script>

