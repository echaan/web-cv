---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/sections/Nav.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import ProjectList from '../components/ui/ProjectList.astro';
import { projects } from '../lib/data';
---

<BaseLayout title="Projects">
  <Nav />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 lg:pt-24 pb-16 sm:pb-20">
    <main
      id="main-content"
      class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-8"
      aria-labelledby="all-projects-heading"
    >
      <SectionTitle title="All Projects" id="all-projects-heading" icon="folder" />
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6 -mt-2">
        A complete collection of data analysis, machine learning, and software development projects.
      </p>
      <ProjectList projects={projects} />
    </main>
  </div>
</BaseLayout>

