---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/sections/Nav.astro';
import ProjectList from '../components/ui/ProjectList.astro';
import { projects } from '../lib/data';
---

<BaseLayout title="Projects">
  <Nav />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 lg:pt-24 pb-16 sm:pb-20">
    <main id="main-content" class="max-w-3xl">
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 pb-3 border-b border-slate-200 mb-8">
        Projects
      </h1>
      <ProjectList projects={projects} />
    </main>
  </div>
</BaseLayout>

