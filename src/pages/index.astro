---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLayout from '../components/layout/PageLayout.astro';
import Nav from '../components/sections/Nav.astro';
import Sidebar from '../components/sections/Sidebar.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import EducationSection from '../components/sections/EducationSection.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import BootcampSection from '../components/sections/BootcampSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import OrganizationsSection from '../components/sections/OrganizationsSection.astro';
import CertificationsSection from '../components/sections/CertificationsSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import {
  profile,
  about,
  education,
  experiences,
  bootcamps,
  organizations,
  certifications,
  skills,
  getFeaturedProjects,
} from '../lib/data';

const featuredProjects = getFeaturedProjects();
---

<BaseLayout title="CV">
  <Nav />
  <PageLayout>
    <Sidebar slot="sidebar" profile={profile} />
    <AboutSection about={about} />
    <EducationSection education={education} />
    <ExperienceSection experiences={experiences} />
    <BootcampSection bootcamps={bootcamps} />
    <ProjectsSection projects={featuredProjects} allProjectsHref="/projects" />
    <OrganizationsSection organizations={organizations} />
    <CertificationsSection certifications={certifications} />
    <SkillsSection skills={skills} />
    <ContactSection profile={profile} />
  </PageLayout>
</BaseLayout>

