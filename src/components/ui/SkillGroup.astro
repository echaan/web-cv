---
import Tag from './Tag.astro';

interface Props {
  category: string;
  skills: string[];
}

const { category, skills } = Astro.props;
---

<div class="skill-group pb-5 last:pb-0 mb-5 last:mb-0 border-b border-slate-100 last:border-b-0">
  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2.5">
    {category}
  </dt>
  <dd class="flex flex-wrap gap-1.5 sm:gap-2">
    {skills.map((skill) => <Tag label={skill} />)}
  </dd>
</div>

