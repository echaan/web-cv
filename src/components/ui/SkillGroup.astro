---
import Tag from './Tag.astro';

interface Props {
  category: string;
  skills: string[];
}

const { category, skills } = Astro.props;
---

<div class="skill-group">
  <dt class="skill-group__category">{category}</dt>
  <dd class="skill-group__skills">
    {skills.map((skill) => <Tag label={skill} />)}
  </dd>
</div>

<style>
  .skill-group {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    align-items: start;
    padding-bottom: var(--space-3);
  }

  .skill-group:last-child {
    padding-bottom: 0;
  }

  .skill-group__category {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    white-space: nowrap;
    padding-top: 0.125rem;
  }

  .skill-group__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
  }
</style>
