---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props;
---

<span
  class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium text-slate-700 bg-slate-100/90 border border-slate-200/90 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-200/80 transition-colors duration-150 motion-safe:hover:-translate-y-0.5 motion-safe:transition-all cursor-default select-none ${className}`}
>
  {label}
</span>

