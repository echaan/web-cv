interface Props {
  name: IconName | string;
  class?: string;
  size?: number | string;
  'aria-hidden'?: boolean | 'true' | 'false';
  'aria-label'?: string;
}

const {
  name,
  class: className = 'w-4 h-4',
  size,
  'aria-hidden': ariaHidden = true,
  'aria-label': ariaLabel,
