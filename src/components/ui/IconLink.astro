---
interface Props {
  href: string;
  label: string;
  /** Short text displayed as the link — e.g. "linkedin.com/in/…" or "Email" */
  text?: string;
  external?: boolean;
}

const { href, label, text, external = false } = Astro.props;

const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a href={href} aria-label={label} rel={rel} target={target} class="icon-link">
  {text ?? label}
</a>

<style>
  .icon-link {
    color: var(--color-accent);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--transition-fast);
    word-break: break-all;
  }

  .icon-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .icon-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
