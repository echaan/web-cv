---
/**
 * EntryCard: structural entry for CV sections (Experience, Education, Bootcamp, Organization, Certification).
 * Provides consistent date/period placement (right-aligned on desktop) and clean hierarchy.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<article class={`border-b border-slate-200/80 last:border-b-0 pb-6 last:pb-0 mb-6 last:mb-0 ${className}`}>
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 mb-1">
    <slot name="header" />
  </div>
  <div class="mb-2">
    <slot name="meta" />
  </div>
  <div class="mt-2">
    <slot />
  </div>
</article>

