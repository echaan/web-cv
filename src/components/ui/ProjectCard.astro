---
import type { Project } from '../../types';
import Tag from './Tag.astro';
import IconLink from './IconLink.astro';

interface Props {
  project: Project;
  /** When true, renders a case-study link if a detail page exists. */
  hasCaseStudy?: boolean;
}

const { project, hasCaseStudy = false } = Astro.props;
const { title, role, description, tags, documentationUrl, slug } = project;
const caseStudyHref = `/projects/${slug}`;
---

<article class="project-card">
  <header class="project-card__header">
    <h3 class="project-card__title">{title}</h3>
    <p class="project-card__role">{role}</p>
  </header>

  <p class="project-card__description">{description}</p>

  {
    tags.length > 0 && (
      <ul class="project-card__tags" role="list">
        {tags.map((tag) => (
          <li>
            <Tag label={tag} />
          </li>
        ))}
      </ul>
    )
  }

  {
    (documentationUrl || hasCaseStudy) && (
      <footer class="project-card__links">
        {documentationUrl && (
          <IconLink
            href={documentationUrl}
            label={`View documentation for ${title}`}
            text="Documentation"
            external
          />
        )}
        {hasCaseStudy && (
          <IconLink
            href={caseStudyHref}
            label={`Read case study for ${title}`}
            text="Case Study"
          />
        )}
      </footer>
    )
  }
</article>

<style>
  .project-card {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: var(--space-4);
    background-color: var(--color-bg);
    transition: border-color var(--transition-fast);
  }

  @media (min-width: 480px) {
    .project-card {
      padding: var(--space-6);
    }
  }

  .project-card:hover {
    border-color: var(--color-text-muted);
  }

  .project-card__header {
    margin-bottom: var(--space-3);
  }

  .project-card__title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .project-card__role {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .project-card__description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .project-card__tags:last-child {
    margin-bottom: 0;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--color-border);
  }
</style>
