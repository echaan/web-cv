---
import type { Project } from '../../types';
import Tag from './Tag.astro';
import IconLink from './IconLink.astro';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  /** When true, renders a case-study link if a detail page exists. */
  hasCaseStudy?: boolean;
}

const { project, hasCaseStudy = false } = Astro.props;
const { title, role, description, tags, documentationUrl, slug } = project;
const caseStudyHref = `/projects/${slug}`;
---

<article class="bg-white rounded-xl border border-slate-200/90 p-5 sm:p-6 shadow-xs hover:border-slate-300 hover:shadow-sm transition-all duration-150 flex flex-col justify-between">
  <div>
    <div class="flex items-start justify-between gap-4 mb-2">
      <div>
        <h3 class="text-base sm:text-lg font-semibold text-slate-900 tracking-tight leading-snug">
          {title}
        </h3>
        <p class="text-xs sm:text-sm font-medium text-slate-500 mt-0.5">{role}</p>
      </div>
      {documentationUrl && (
        <a
          href={documentationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-1.5 text-slate-400 hover:text-blue-600 hover:bg-slate-50 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[36px] min-w-[36px] flex items-center justify-center shrink-0"
          aria-label={`View documentation for ${title}`}
          title="View documentation"
        >
          <Icon name="file-text" class="w-4 h-4" />
        </a>
      )}
    </div>

    <p class="text-sm text-slate-600 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <div>
    {tags && tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5 sm:gap-2 mb-0" role="list">
        {tags.map((tag) => (
          <li>
            <Tag label={tag} />
          </li>
        ))}
      </ul>
    )}

    {hasCaseStudy && (
      <footer class="mt-4 pt-3 border-t border-slate-100 flex items-center">
        <IconLink
          href={caseStudyHref}
          label={`Read case study for ${title}`}
          text="Read Case Study"
          icon="file-text"
        />
      </footer>
    )}
  </div>
</article>

