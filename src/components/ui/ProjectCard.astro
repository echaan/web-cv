---
import type { Project } from '../../types';
import Tag from './Tag.astro';
import IconLink from './IconLink.astro';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  /** When true, renders a case-study link if a detail page exists. */
  hasCaseStudy?: boolean;
  /** When true, renders a "View Slides" button to select the project in the document viewer. */
  showViewSlides?: boolean;
}

const { project, hasCaseStudy = false, showViewSlides = false } = Astro.props;
const { title, role, description, tags, documentationUrl, slug, slidesPdf } = project;
const caseStudyHref = `/projects/${slug}`;
---

<article
  id={slug}
  class={`project-card relative bg-slate-50/70 rounded-xl border border-slate-200/90 p-5 sm:p-6 hover:border-slate-300 hover:bg-slate-50/90 transition-all duration-150 flex flex-col justify-between ${
    showViewSlides ? 'aria-[current=true]:border-blue-600 aria-[current=true]:bg-blue-50/40 aria-[current=true]:ring-1 aria-[current=true]:ring-blue-600' : ''
  } ${showViewSlides ? 'cursor-pointer' : ''}`}
  data-project-slug={slug}
  data-project-title={title}
  data-slides-pdf={slidesPdf || ''}
>
  <div>
    <div class="flex items-start justify-between gap-4 mb-2">
      <div>
        <h3 class="text-base sm:text-lg font-semibold text-slate-900 tracking-tight leading-snug">
          {title}
        </h3>
        <p class="text-xs sm:text-sm font-medium text-slate-500 mt-0.5">{role}</p>
      </div>
      {documentationUrl && (
        <a
          href={documentationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-20 p-2 text-blue-600 hover:text-blue-700 hover:bg-white rounded-lg border border-transparent hover:border-slate-200 transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 min-h-[40px] min-w-[40px] flex items-center justify-center shrink-0 motion-safe:hover:-translate-y-0.5"
          aria-label={`View documentation for ${title}`}
          title="View documentation"
        >
          <Icon name="file-text" class="w-4 h-4" />
        </a>
      )}
    </div>

    <p class="text-sm text-slate-600 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <div>
    {tags && tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5 sm:gap-2 mb-0" role="list">
        {tags.map((tag) => (
          <li>
            <Tag label={tag} />
          </li>
        ))}
      </ul>
    )}

    {showViewSlides && (
      <button
        type="button"
        class="view-slides-btn absolute inset-0 z-10 w-full h-full rounded-xl text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 cursor-pointer"
        data-target-slug={slug}
        aria-label={`View slides for ${title}`}
      />
    )}

    {hasCaseStudy && (
      <footer class="mt-4 pt-3 border-t border-slate-200/60 flex items-center">
        <IconLink
          href={caseStudyHref}
          label={`Read case study for ${title}`}
          text="Read Case Study"
          icon="file-text"
        />
      </footer>
    )}
  </div>
</article>
