---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  id: string;
  icon?: IconName | string;
  class?: string;
}

const { title, id, icon, class: className = '' } = Astro.props;

// Section icon mapping based on standard ID or title if icon is not provided
const defaultIconMap: Record<string, IconName> = {
  about: 'user',
  'about-heading': 'user',
  education: 'graduation-cap',
  'education-heading': 'graduation-cap',
  experience: 'briefcase',
  'experience-heading': 'briefcase',
  bootcamp: 'code',
  'bootcamp-heading': 'code',
  projects: 'folder',
  'projects-heading': 'folder',
  organization: 'users',
  'organization-heading': 'users',
  organizations: 'users',
  'organizations-heading': 'users',
  certifications: 'award',
  'certifications-heading': 'award',
  skills: 'wrench',
  'skills-heading': 'wrench',
  contact: 'mail',
  'contact-heading': 'mail',
};

const resolvedIcon = icon || defaultIconMap[id.toLowerCase()] || defaultIconMap[title.toLowerCase()];
---

<div class={`flex items-center gap-2.5 pb-3 border-b border-slate-200/90 mb-6 ${className}`}>
  {resolvedIcon && (
    <div class="flex items-center justify-center text-blue-600 shrink-0" aria-hidden="true">
      <Icon name={resolvedIcon} class="w-5 h-5" />
    </div>
  )}
  <h2 id={id} class="text-xl font-bold tracking-tight text-slate-900 leading-tight">
    {title}
  </h2>
</div>

