---
interface Props {
  title: string;
  id: string;
}

const { title, id } = Astro.props;
---

<h2 id={id} class="section-title">{title}</h2>

<style>
  .section-title {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-6);
  }
</style>
