---
import type { Experience } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';
import EntryCard from '../ui/EntryCard.astro';

interface Props {
  experiences: Experience[];
}

const { experiences } = Astro.props;
---

<section
  id="experience"
  class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-7"
  aria-labelledby="experience-heading"
>
  <SectionTitle title="Experience" id="experience-heading" />

  <div>
    {
      experiences.map((exp) => (
        <EntryCard>
          <Fragment slot="header">
            <h3 class="text-base sm:text-lg font-semibold text-slate-900 tracking-tight leading-snug">
              {exp.role}
            </h3>
            <span class="text-xs sm:text-sm font-medium text-slate-500 sm:text-right shrink-0">
              {exp.period}
            </span>
          </Fragment>
          <div slot="meta">
            <p class="text-sm font-medium text-slate-600">{exp.organization}</p>
          </div>
          <ul class="space-y-2 mt-2 list-disc list-outside pl-4 text-sm text-slate-700 leading-relaxed" role="list">
            {exp.contributions.map((item) => (
              <li class="pl-1">{item}</li>
            ))}
          </ul>
        </EntryCard>
      ))
    }
  </div>
</section>
