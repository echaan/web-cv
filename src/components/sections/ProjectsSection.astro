---
import type { Project } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';
import ProjectList from '../ui/ProjectList.astro';
import IconLink from '../ui/IconLink.astro';

interface Props {
  projects: Project[];
  /** When provided, renders a "View all projects" link pointing to this href. */
  allProjectsHref?: string;
}

const { projects, allProjectsHref } = Astro.props;
---

<section
  id="projects"
  class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-7"
  aria-labelledby="projects-heading"
>
  <SectionTitle title="Projects" id="projects-heading" />
  <ProjectList projects={projects} />
  {
    allProjectsHref && (
      <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-end">
        <IconLink
          href={allProjectsHref}
          label="View all projects"
          text="View all projects"
          icon="chevron-right"
          iconPosition="right"
        />
      </div>
    )
  }
</section>
