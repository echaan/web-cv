---
import type { Certification } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';

interface Props {
  certifications: Certification[];
}

const { certifications } = Astro.props;
---

<section id="certifications" class="section">
  <SectionTitle title="Certifications" id="certifications-heading" />

  <ul class="cert-list" role="list">
    {
      certifications.map((cert) => (
        <li class="cert-entry">
          <div class="cert-header">
            <div class="cert-name-wrap">
              {cert.credentialUrl ? (
                <a
                  href={cert.credentialUrl}
                  class="cert-name cert-name--link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View credential: ${cert.certificate}`}
                >
                  {cert.certificate}
                </a>
              ) : (
                <span class="cert-name">{cert.certificate}</span>
              )}
            </div>
            <span class="cert-date">{cert.date}</span>
          </div>
          <p class="cert-issuer">{cert.issuer}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    margin-bottom: var(--space-12);
  }

  .cert-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cert-entry {
    padding-bottom: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-4);
  }

  .cert-entry:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .cert-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    margin-bottom: var(--space-1);
  }

  .cert-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
  }

  .cert-name--link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .cert-name--link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .cert-name--link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .cert-date {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .cert-issuer {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
