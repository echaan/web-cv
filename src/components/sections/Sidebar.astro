---
import type { Profile } from '../../types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { name, title, location, email, linkedin, github, photo, cvFile } = profile;
---

<aside class="w-full bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 md:p-7 lg:p-7" aria-label="Profile">
  <div class="flex flex-col items-center text-center md:flex-row md:items-center md:text-left md:gap-8 lg:flex-col lg:items-start lg:text-left lg:gap-6">
    <!-- Photo frame with reusable fallback -->
    <div class="relative w-24 h-24 sm:w-28 sm:h-28 lg:w-32 lg:h-32 rounded-2xl overflow-hidden bg-slate-100 ring-1 ring-slate-200/80 shrink-0 mb-4 md:mb-0 lg:mb-0">
      <img
        id="profile-avatar"
        src={photo}
        alt={`Photo of ${name}`}
        width="128"
        height="128"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- Identity and details container -->
    <div class="flex-1 min-w-0 flex flex-col items-center md:items-start lg:items-start w-full">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 leading-tight">{name}</h1>
        <p class="text-sm font-medium text-slate-600 leading-snug">{title}</p>
      </div>

      {location && (
        <div class="flex items-center gap-1.5 text-xs sm:text-sm text-slate-500 mt-3 font-normal">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-slate-400 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>{location}</span>
        </div>
      )}

      <!-- Social icons row -->
      <div class="flex items-center gap-2 mt-4 pt-1">
        {email && (
          <a
            href={`mailto:${email}`}
            aria-label={`Send email to ${name}`}
            class="p-2 text-slate-500 hover:text-blue-600 hover:bg-slate-100 active:bg-slate-200 rounded-lg transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            title={`Email: ${email}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span class="sr-only">Email</span>
          </a>
        )}

        {linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} on LinkedIn`}
            class="p-2 text-slate-500 hover:text-blue-600 hover:bg-slate-100 active:bg-slate-200 rounded-lg transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            title="LinkedIn profile"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.54a1.63 1.63 0 1 0 0 3.26 1.63 1.63 0 0 0 0-3.26Z"/>
            </svg>
            <span class="sr-only">LinkedIn</span>
          </a>
        )}

        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} on GitHub`}
            class="p-2 text-slate-500 hover:text-blue-600 hover:bg-slate-100 active:bg-slate-200 rounded-lg transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            title="GitHub profile"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span class="sr-only">GitHub</span>
          </a>
        )}
      </div>

      <!-- Download CV Button -->
      {cvFile && (
        <div class="mt-5 w-full md:w-auto lg:w-full">
          <a
            href={cvFile}
            download
            class="inline-flex items-center justify-center gap-2 w-full md:w-auto lg:w-full px-4 py-2.5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white text-sm font-medium rounded-lg shadow-xs hover:shadow transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-600"
            aria-label="Download CV as PDF"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            <span>Download CV</span>
          </a>
        </div>
      )}
    </div>
  </div>
</aside>

<script>
  const avatar = document.getElementById('profile-avatar') as HTMLImageElement | null;
  if (avatar) {
    avatar.addEventListener('error', () => {
      avatar.src = '/assets/images/profile-placeholder.svg';
    });
  }
</script>


