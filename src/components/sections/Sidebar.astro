---
import type { Profile } from '../../types';
import IconLink from '../ui/IconLink.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { name, title, location, email, linkedin, github, photo, cvFile } = profile;
---

<aside class="sidebar" aria-label="Profile">
  {
    photo && (
      <div class="sidebar__photo-wrap">
        <img
          src={photo}
          alt={`Photo of ${name}`}
          width="120"
          height="120"
          class="sidebar__photo"
          loading="eager"
          decoding="async"
        />
      </div>
    )
  }

  <div class="sidebar__identity">
    <h1 class="sidebar__name">{name}</h1>
    <p class="sidebar__title">{title}</p>
  </div>

  <dl class="sidebar__details">
    <div class="sidebar__detail-row">
      <dt class="sr-only">Location</dt>
      <dd class="sidebar__detail-text">{location}</dd>
    </div>

    <div class="sidebar__detail-row">
      <dt class="sr-only">Email</dt>
      <dd>
        <IconLink
          href={`mailto:${email}`}
          label={`Email ${name}`}
          text={email}
        />
      </dd>
    </div>

    {
      linkedin && (
        <div class="sidebar__detail-row">
          <dt class="sr-only">LinkedIn</dt>
          <dd>
            <IconLink
              href={linkedin}
              label={`${name} on LinkedIn`}
              text="LinkedIn"
              external
            />
          </dd>
        </div>
      )
    }

    {
      github && (
        <div class="sidebar__detail-row">
          <dt class="sr-only">GitHub</dt>
          <dd>
            <IconLink
              href={github}
              label={`${name} on GitHub`}
              text="GitHub"
              external
            />
          </dd>
        </div>
      )
    }
  </dl>

  {
    cvFile && (
      <a href={cvFile} class="sidebar__cv-btn" download aria-label="Download CV as PDF">
        Download CV
      </a>
    )
  }
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Visually hidden but accessible to screen readers */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Photo */
  .sidebar__photo-wrap {
    line-height: 0;
  }

  .sidebar__photo {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 0.5rem;
    display: block;
  }

  @media (min-width: 1024px) {
    .sidebar__photo {
      width: 120px;
      height: 120px;
    }
  }

  /* Identity */
  .sidebar__name {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .sidebar__title {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Contact details */
  .sidebar__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sidebar__detail-row {
    display: contents;
  }

  .sidebar__detail-text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Download CV button */
  .sidebar__cv-btn {
    display: inline-block;
    background-color: var(--color-accent);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    padding: var(--space-2) var(--space-4);
    border-radius: 0.375rem;
    text-decoration: none;
    text-align: center;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
    align-self: flex-start;
  }

  .sidebar__cv-btn:hover {
    background-color: var(--color-accent-hover);
    color: #ffffff;
  }

  .sidebar__cv-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
