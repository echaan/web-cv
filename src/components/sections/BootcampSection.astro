---
import type { Bootcamp } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';
import EntryCard from '../ui/EntryCard.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  bootcamps: Bootcamp[];
}

const { bootcamps } = Astro.props;
---

<section id="bootcamp" class="section">
  <SectionTitle title="Bootcamp" id="bootcamp-heading" />

  <div class="entry-list">
    {
      bootcamps.map((camp) => (
        <EntryCard>
          <div slot="header">
            <h3 class="entry-title">{camp.role}</h3>
            <span class="entry-period">{camp.period}</span>
          </div>
          <div slot="meta">
            <p class="entry-org">{camp.organization}</p>
          </div>
          <div class="entry-body">
            <p class="entry-description">{camp.description}</p>
            {camp.finalProject && (
              <p class="entry-project">
                <span class="entry-label">Final Project:</span> {camp.finalProject}
              </p>
            )}
            {camp.tags && camp.tags.length > 0 && (
              <ul class="tag-list" role="list">
                {camp.tags.map((tag) => (
                  <li>
                    <Tag label={tag} />
                  </li>
                ))}
              </ul>
            )}
          </div>
        </EntryCard>
      ))
    }
  </div>
</section>

<style>
  .section {
    margin-bottom: var(--space-12);
  }

  .entry-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .entry-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .entry-period {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .entry-org {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .entry-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    margin: 0;
  }

  .entry-project {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .entry-label {
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
