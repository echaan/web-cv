---
import type { Profile } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';
import IconLink from '../ui/IconLink.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { name, email, linkedin, github, cvFile } = profile;
---

<section id="contact" class="section">
  <SectionTitle title="Contact" id="contact-heading" />

  <ul class="contact-list" role="list">
    <li class="contact-item">
      <span class="contact-label">Email</span>
      <IconLink href={`mailto:${email}`} label={`Email ${name}`} text={email} />
    </li>

    {
      linkedin && (
        <li class="contact-item">
          <span class="contact-label">LinkedIn</span>
          <IconLink href={linkedin} label={`${name} on LinkedIn`} text="LinkedIn" external />
        </li>
      )
    }

    {
      github && (
        <li class="contact-item">
          <span class="contact-label">GitHub</span>
          <IconLink href={github} label={`${name} on GitHub`} text="GitHub" external />
        </li>
      )
    }

    {
      cvFile && (
        <li class="contact-item">
          <span class="contact-label">CV</span>
          <a href={cvFile} class="cv-download" download aria-label="Download CV as PDF">
            Download CV (PDF)
          </a>
        </li>
      )
    }
  </ul>
</section>

<style>
  .section {
    margin-bottom: var(--space-12);
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .contact-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    min-width: 5rem;
    flex-shrink: 0;
  }

  .cv-download {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .cv-download:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .cv-download:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
