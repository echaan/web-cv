---
import type { Profile } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { name, email, linkedin, github, cvFile } = profile;
---

<section
  id="contact"
  class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-7"
  aria-labelledby="contact-heading"
>
  <SectionTitle title="Contact" id="contact-heading" />

  <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6">
    I'm always interested in new opportunities, collaborations, and discussions in data analytics and machine learning. Feel free to reach out directly.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
    {email && (
      <a
        href={`mailto:${email}`}
        class="flex items-center gap-3 p-3.5 sm:p-4 rounded-xl border border-slate-200/80 bg-slate-50/60 hover:bg-blue-50/70 hover:border-blue-200 text-slate-800 hover:text-blue-700 transition-all duration-150 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
        aria-label={`Send email to ${email}`}
      >
        <div class="w-10 h-10 rounded-lg bg-white border border-slate-200/80 group-hover:border-blue-200 group-hover:bg-blue-600 text-slate-600 group-hover:text-white flex items-center justify-center shrink-0 transition-all duration-150">
          <Icon name="mail" class="w-5 h-5" />
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-blue-600 transition-colors">
            Email
          </div>
          <div class="text-sm font-medium text-slate-900 group-hover:text-blue-700 truncate transition-colors">
            {email}
          </div>
        </div>
      </a>
    )}

    {linkedin && (
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 p-3.5 sm:p-4 rounded-xl border border-slate-200/80 bg-slate-50/60 hover:bg-blue-50/70 hover:border-blue-200 text-slate-800 hover:text-blue-700 transition-all duration-150 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
        aria-label={`${name} on LinkedIn`}
      >
        <div class="w-10 h-10 rounded-lg bg-white border border-slate-200/80 group-hover:border-blue-200 group-hover:bg-blue-600 text-slate-600 group-hover:text-white flex items-center justify-center shrink-0 transition-all duration-150">
          <Icon name="linkedin" class="w-5 h-5" />
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-blue-600 transition-colors">
            LinkedIn
          </div>
          <div class="text-sm font-medium text-slate-900 group-hover:text-blue-700 truncate transition-colors">
            Connect on LinkedIn
          </div>
        </div>
        <Icon name="external-link" class="w-4 h-4 text-slate-400 group-hover:text-blue-600 shrink-0 mr-1" aria-hidden="true" />
      </a>
    )}

    {github && (
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 p-3.5 sm:p-4 rounded-xl border border-slate-200/80 bg-slate-50/60 hover:bg-blue-50/70 hover:border-blue-200 text-slate-800 hover:text-blue-700 transition-all duration-150 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
        aria-label={`${name} on GitHub`}
      >
        <div class="w-10 h-10 rounded-lg bg-white border border-slate-200/80 group-hover:border-blue-200 group-hover:bg-blue-600 text-slate-600 group-hover:text-white flex items-center justify-center shrink-0 transition-all duration-150">
          <Icon name="github" class="w-5 h-5" />
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-blue-600 transition-colors">
            GitHub
          </div>
          <div class="text-sm font-medium text-slate-900 group-hover:text-blue-700 truncate transition-colors">
            Explore Repositories
          </div>
        </div>
        <Icon name="external-link" class="w-4 h-4 text-slate-400 group-hover:text-blue-600 shrink-0 mr-1" aria-hidden="true" />
      </a>
    )}

    {cvFile && (
      <a
        href={cvFile}
        download
        class="flex items-center gap-3 p-3.5 sm:p-4 rounded-xl border border-slate-200/80 bg-slate-50/60 hover:bg-blue-50/70 hover:border-blue-200 text-slate-800 hover:text-blue-700 transition-all duration-150 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
        aria-label="Download CV as PDF"
      >
        <div class="w-10 h-10 rounded-lg bg-white border border-slate-200/80 group-hover:border-blue-200 group-hover:bg-blue-600 text-slate-600 group-hover:text-white flex items-center justify-center shrink-0 transition-all duration-150">
          <Icon name="download" class="w-5 h-5" />
        </div>
        <div class="min-w-0 flex-1">
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-blue-600 transition-colors">
            Curriculum Vitae
          </div>
          <div class="text-sm font-medium text-slate-900 group-hover:text-blue-700 truncate transition-colors">
            Download CV (PDF)
          </div>
        </div>
      </a>
    )}
  </div>
</section>
