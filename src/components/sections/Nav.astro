---
import MobileNav from '../ui/MobileNav.astro';
---

<header class="site-header">
  <nav class="desktop-nav" aria-label="Site navigation">
    <ul class="desktop-nav__list" role="list">
      <li><a href="/#about" class="desktop-nav__link">About</a></li>
      <li><a href="/#education" class="desktop-nav__link">Education</a></li>
      <li><a href="/#experience" class="desktop-nav__link">Experience</a></li>
      <li><a href="/#projects" class="desktop-nav__link">Projects</a></li>
      <li><a href="/#contact" class="desktop-nav__link">Contact</a></li>
    </ul>
  </nav>

  <div class="mobile-nav-wrapper">
    <MobileNav />
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-8);
    padding: 0 var(--space-4);
  }

  @media (min-width: 640px) {
    .site-header {
      padding: 0 var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .site-header {
      padding: 0 var(--space-8);
    }
  }

  /* Desktop nav: visible ≥768px */
  .desktop-nav {
    display: none;
  }

  .desktop-nav__list {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0;
  }

  .desktop-nav__link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .desktop-nav__link:hover {
    color: var(--color-accent);
  }

  .desktop-nav__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Mobile nav: visible <768px */
  .mobile-nav-wrapper {
    display: flex;
    align-items: center;
    padding: var(--space-3) 0;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }

    .mobile-nav-wrapper {
      display: none;
    }
  }
</style>
