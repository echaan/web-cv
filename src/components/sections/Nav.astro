---
import MobileNav from '../ui/MobileNav.astro';
---

<header class="fixed top-0 inset-x-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/90 shadow-xs h-16 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full">
    <!-- Desktop Layout (>=1024px): 2-column grid matching PageLayout alignment -->
    <div class="hidden lg:grid lg:grid-cols-[320px_minmax(0,1fr)] lg:gap-12 xl:gap-16 items-center h-full">
      <!-- Left Column: Brand aligns with Profile Column -->
      <div class="flex items-center">
        <a
          href="/"
          class="group flex items-center gap-2.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg py-1"
          aria-label="Homepage - M. Eric Chaniago"
        >
          <img
            src="/assets/images/logo.webp"
            alt="M. Eric Chaniago Logo"
            width="489"
            height="720"
            class="h-8 w-auto object-contain shrink-0"
            loading="eager"
            decoding="async"
          />
          <span class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors text-sm tracking-tight">
            M. Eric Chaniago
          </span>
        </a>
      </div>

      <!-- Right Column: Navigation links -->
      <nav class="flex items-center justify-start" aria-label="Desktop site navigation">
        <ul class="flex items-center gap-1 xl:gap-2" role="list">
          <li>
            <a
              href="/#about"
              data-nav-link="about"
              class="nav-link px-3.5 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              About
            </a>
          </li>
          <li>
            <a
              href="/#education"
              data-nav-link="education"
              class="nav-link px-3.5 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Education
            </a>
          </li>
          <li>
            <a
              href="/#experience"
              data-nav-link="experience"
              class="nav-link px-3.5 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Experience
            </a>
          </li>
          <li>
            <a
              href="/#projects"
              data-nav-link="projects"
              class="nav-link px-3.5 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Projects
            </a>
          </li>
          <li>
            <a
              href="/#contact"
              data-nav-link="contact"
              class="nav-link px-3.5 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Tablet Layout (768px - 1023px): Centered single-row navigation -->
    <div class="hidden md:flex lg:hidden items-center justify-between h-full">
      <a
        href="/"
        class="group flex items-center gap-2.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg py-1"
        aria-label="Homepage - M. Eric Chaniago"
      >
        <img
          src="/assets/images/logo.webp"
          alt="M. Eric Chaniago Logo"
          width="489"
          height="720"
          class="h-8 w-auto object-contain shrink-0"
          loading="eager"
          decoding="async"
        />
        <span class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors text-sm tracking-tight">
          M. Eric Chaniago
        </span>
      </a>

      <nav class="flex items-center" aria-label="Tablet site navigation">
        <ul class="flex items-center gap-1 sm:gap-2" role="list">
          <li>
            <a
              href="/#about"
              data-nav-link="about"
              class="nav-link px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              About
            </a>
          </li>
          <li>
            <a
              href="/#education"
              data-nav-link="education"
              class="nav-link px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Education
            </a>
          </li>
          <li>
            <a
              href="/#experience"
              data-nav-link="experience"
              class="nav-link px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Experience
            </a>
          </li>
          <li>
            <a
              href="/#projects"
              data-nav-link="projects"
              class="nav-link px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Projects
            </a>
          </li>
          <li>
            <a
              href="/#contact"
              data-nav-link="contact"
              class="nav-link px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Mobile Layout (<768px): Brand + MobileNav toggle -->
    <div class="flex md:hidden items-center justify-between h-full">
      <a
        href="/"
        class="group flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg py-1"
        aria-label="Homepage - M. Eric Chaniago"
      >
        <img
          src="/assets/images/logo.webp"
          alt="M. Eric Chaniago Logo"
          width="489"
          height="720"
          class="h-7 w-auto object-contain shrink-0"
          loading="eager"
          decoding="async"
        />
        <span class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors text-sm tracking-tight">
          M. Eric Chaniago
        </span>
      </a>

      <MobileNav />
    </div>
  </div>
</header>

<script>
  function initScrollSpy() {
    const sectionIds = ['about', 'education', 'experience', 'projects', 'contact'];
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const mobileNavLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav-link]');

    function updateActiveLink() {
      let currentSectionId = '';
      const scrollPosition = window.scrollY + 120;

      for (const id of sectionIds) {
        const section = document.getElementById(id);
        if (section) {
          const top = section.offsetTop;
          const height = section.offsetHeight;
          if (scrollPosition >= top && scrollPosition < top + height) {
            currentSectionId = id;
            break;
          }
        }
      }

      navLinks.forEach((link) => {
        const linkSection = link.getAttribute('data-nav-link');
        if (linkSection === currentSectionId) {
          link.classList.add('text-blue-600', 'font-semibold', 'bg-blue-50/80');
          link.classList.remove('text-slate-600');
        } else {
          link.classList.remove('text-blue-600', 'font-semibold', 'bg-blue-50/80');
          link.classList.add('text-slate-600');
        }
      });

      mobileNavLinks.forEach((link) => {
        const linkSection = link.getAttribute('data-mobile-nav-link');
        if (linkSection === currentSectionId) {
          link.classList.add('text-blue-600', 'font-semibold', 'bg-blue-50/80');
          link.classList.remove('text-slate-700');
        } else {
          link.classList.remove('text-blue-600', 'font-semibold', 'bg-blue-50/80');
          link.classList.add('text-slate-700');
        }
      });
    }

    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollSpy);
  } else {
    initScrollSpy();
  }
</script>

