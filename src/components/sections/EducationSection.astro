---
import type { Education } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';

interface Props {
  education: Education;
}

const { education } = Astro.props;
const { university, degree, major, period, gpa, coursework, publication } = education;
---

<section id="education" class="section">
  <SectionTitle title="Education" id="education-heading" />

  <article class="entry">
    <div class="entry-header">
      <h3 class="entry-title">{university}</h3>
      <span class="entry-period">{period}</span>
    </div>

    <p class="entry-subtitle">
      {degree}{major ? `, ${major}` : ''}
      {gpa && <span class="entry-gpa"> &mdash; GPA: {gpa}</span>}
    </p>

    {
      coursework && coursework.length > 0 && (
        <div class="entry-block">
          <h4 class="entry-label">Relevant Coursework</h4>
          <ul class="coursework-list" role="list">
            {coursework.map((course) => (
              <li>{course}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      publication && (
        <div class="entry-block">
          <h4 class="entry-label">Publication</h4>
          {publication.url ? (
            <a href={publication.url} class="publication-link" target="_blank" rel="noopener noreferrer">
              {publication.title}
            </a>
          ) : (
            <p class="publication-title">{publication.title}</p>
          )}
        </div>
      )
    }
  </article>
</section>

<style>
  .section {
    margin-bottom: var(--space-12);
  }

  .entry-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    margin-bottom: var(--space-1);
  }

  .entry-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .entry-period {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .entry-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 0;
  }

  .entry-gpa {
    color: var(--color-text-muted);
  }

  .entry-block {
    margin-top: var(--space-4);
  }

  .entry-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .coursework-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .coursework-list li + li::before {
    content: '·';
    margin-right: var(--space-3);
  }

  .publication-title,
  .publication-link {
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .publication-title {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .publication-link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .publication-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .publication-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
