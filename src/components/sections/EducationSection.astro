---
import type { Education } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';
import Tag from '../ui/Tag.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  education: Education;
}

const { education } = Astro.props;
const { university, degree, major, period, gpa, coursework, publication } = education;
---

<section
  id="education"
  class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-7"
  aria-labelledby="education-heading"
>
  <SectionTitle title="Education" id="education-heading" />

  <article>
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 mb-1">
      <h3 class="text-base sm:text-lg font-semibold text-slate-900 tracking-tight leading-snug">
        {university}
      </h3>
      <span class="text-xs sm:text-sm font-medium text-slate-500 sm:text-right shrink-0">
        {period}
      </span>
    </div>

    <div class="space-y-0.5 mb-3">
      <p class="text-sm font-medium text-slate-700">
        {degree}{major ? `, ${major}` : ''}
      </p>
      {gpa && (
        <p class="text-xs sm:text-sm text-slate-500">
          GPA: <span class="font-medium text-slate-600">{gpa}</span>
        </p>
      )}
    </div>

    {publication && (
      <div class="mt-5 pt-4 border-t border-slate-100">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
          Publication
        </h4>
        <div class="flex items-start gap-2 text-sm">
          <Icon name="file-text" class="w-4 h-4 text-blue-600 shrink-0 mt-0.5" aria-hidden="true" />
          {publication.url ? (
            <a
              href={publication.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-blue-600 hover:text-blue-700 hover:underline transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-xs"
            >
              {publication.title}
            </a>
          ) : (
            <span class="text-slate-700 leading-relaxed">{publication.title}</span>
          )}
        </div>
      </div>
    )}

    {coursework && coursework.length > 0 && (
      <div class="mt-5 pt-4 border-t border-slate-100">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2.5">
          Relevant Coursework
        </h4>
        <ul class="flex flex-wrap gap-1.5 sm:gap-2" role="list">
          {coursework.map((course) => (
            <li>
              <Tag label={course} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>
</section>
