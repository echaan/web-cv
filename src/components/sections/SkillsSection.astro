---
import type { SkillGroup as SkillGroupType } from '../../types';
import SectionTitle from '../ui/SectionTitle.astro';
import SkillGroup from '../ui/SkillGroup.astro';

interface Props {
  skills: SkillGroupType[];
}

const { skills } = Astro.props;
---

<section
  id="skills"
  class="bg-white rounded-2xl border border-slate-200/90 shadow-xs p-6 sm:p-7"
  aria-labelledby="skills-heading"
>
  <SectionTitle title="Skills" id="skills-heading" />
  <dl class="m-0 p-0">
    {skills.map((group) => <SkillGroup category={group.category} skills={group.skills} />)}
  </dl>
</section>
