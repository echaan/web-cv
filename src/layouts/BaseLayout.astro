---
// BaseLayout: Document-level HTML structure
// Provides the HTML shell, metadata, font loading, and global styling

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CV',
  description = 'Personal CV and portfolio showcasing experience, projects, and skills.',
} = Astro.props;

const pageTitle = title === 'CV' ? 'M. Eric Chaniago | CV' : `${title} | M. Eric Chaniago`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased selection:bg-blue-100 selection:text-blue-900">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:font-medium focus:text-sm focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

